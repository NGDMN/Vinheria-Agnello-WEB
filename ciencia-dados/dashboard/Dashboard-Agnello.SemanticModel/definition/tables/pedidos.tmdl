	column FaixaVariacaoOrdem = SWITCH ( TRUE (), ISBLANK ( pedidos[variacao_pedido_anterior_pct] ), 1, pedidos[variacao_pedido_anterior_pct] <= 0, 2, pedidos[variacao_pedido_anterior_pct] <= 50, 3, 4 )
		dataType: int64
		isHidden
		lineageTag: a0fac872-c223-4b77-9790-09bd3f55d1a3
		summarizeBy: none

	column forma_pagamento_en = LOOKUPVALUE ( TradValores[en], TradValores[atributo], "forma_pagamento", TradValores[pt], pedidos[forma_pagamento], pedidos[forma_pagamento] )
		dataType: string
