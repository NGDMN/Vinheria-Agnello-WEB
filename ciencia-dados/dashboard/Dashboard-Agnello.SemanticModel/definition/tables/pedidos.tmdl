	column FaixaPrazo = SWITCH ( TRUE (), pedidos[prazo_entrega_dias] <= 3, "0-3 dias", pedidos[prazo_entrega_dias] <= 6, "4-6 dias", pedidos[prazo_entrega_dias] <= 10, "7-10 dias", "11+ dias" )
		dataType: string
		lineageTag: 2b380c15-5876-43f8-802a-508507183d6a
		summarizeBy: none
		sortByColumn: FaixaPrazoOrdem

	column FaixaPrazoOrdem = SWITCH ( TRUE (), pedidos[prazo_entrega_dias] <= 3, 1, pedidos[prazo_entrega_dias] <= 6, 2, pedidos[prazo_entrega_dias] <= 10, 3, 4 )
		dataType: int64
		isHidden
		lineageTag: daff4cec-bd29-4624-a949-823ffe91d82e
		summarizeBy: none

	column Situacao = SWITCH ( pedidos[venda_sucesso], 1, "Pago", 0, "Não pago", "Aguardando" )
		dataType: string
		lineageTag: 152972e8-d38b-4acd-97f1-fd72ad918ada
		summarizeBy: none

	column FaixaVariacao = SWITCH ( TRUE (), ISBLANK ( pedidos[variacao_pedido_anterior_pct] ), "Primeiro pedido", pedidos[variacao_pedido_anterior_pct] <= 0, "Redução", pedidos[variacao_pedido_anterior_pct] <= 50, "Aumento até 50%", "Aumento acima de 50%" )
		dataType: string
		lineageTag: 55306864-03d4-41d3-b1e9-c7f33ebd4ac3
		summarizeBy: none
