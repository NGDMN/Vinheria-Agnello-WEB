	partition pedidos = m
		mode: import
		source =
				let
				    Pedidos = fnCarregarAba("pedidos", {{"id_pedido", Int64.Type}, {"id_cliente", Int64.Type}, {"data_pedido", type date}, {"canal", type text}, {"uf_destino", type text}, {"tipo_frete", type text}, {"valor_frete", Currency.Type}, {"prazo_entrega_dias", Int64.Type}, {"forma_pagamento", type text}, {"pct_desconto", type number}, {"valor_total", Currency.Type}, {"status_pedido", type text}, {"status_entrega", type text}, {"venda_sucesso", Int64.Type}, {"motivo_insucesso", type text}}),
				    BaseMl = Table.SelectColumns(
				        fnCarregarAba("base_ml", {{"id_pedido", Int64.Type}, {"pedidos_anteriores", Int64.Type}, {"variacao_pedido_anterior_pct", type number}}),
				        {"id_pedido", "pedidos_anteriores", "variacao_pedido_anterior_pct"}),
				    Juncao = Table.NestedJoin(Pedidos, {"id_pedido"}, BaseMl, {"id_pedido"}, "ml", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Juncao, "ml", {"pedidos_anteriores", "variacao_pedido_anterior_pct"}),
				    Tipado = Table.TransformColumnTypes(Expandido, {{"pedidos_anteriores", Int64.Type}, {"variacao_pedido_anterior_pct", type number}})
				in
				    Tipado

	annotation PBI_ResultType = Table

