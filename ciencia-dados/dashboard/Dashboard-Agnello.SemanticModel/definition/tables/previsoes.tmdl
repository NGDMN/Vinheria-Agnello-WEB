		dataType: string
		isHidden
		lineageTag: 4d174182-cfa6-4f99-b617-469a4791d4c3
		summarizeBy: none

	column FaixaRiscoOrdem = SWITCH ( previsoes[faixa_risco], "Baixo", 1, "Médio", 2, "Alto", 3 )
		dataType: int64
