	partition previsoes = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoPasta & "resultados\previsoes.csv"),
				        [Delimiter = ";", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipado = Table.TransformColumnTypes(Cabecalho, {{"id_pedido", Int64.Type}, {"conjunto", type text},
				        {"real", type text}, {"previsto", type text}, {"prob_pagamento", type number},
				        {"prob_nao_pagamento", type number}, {"acerto", type text}, {"faixa_risco", type text}}, "pt-BR")
				in
				    Tipado

	annotation PBI_ResultType = Table

