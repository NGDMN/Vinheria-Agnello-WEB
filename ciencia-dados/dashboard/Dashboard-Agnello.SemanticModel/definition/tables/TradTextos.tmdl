table TradTextos
	lineageTag: 94f9cd0b-32cf-48db-bb3d-69e6f2182705

	column chave
		dataType: string
		isHidden
		lineageTag: e7513573-3a2b-4837-98b8-fff24b15bb78
		summarizeBy: none
		sourceColumn: chave

	column Idioma
		dataType: string
		isHidden
		lineageTag: 275de9bb-f711-4ff7-98f0-b646c100ae13
		summarizeBy: none
		sourceColumn: Idioma

	column Texto
		dataType: string
		isHidden
		lineageTag: 2bb12711-54da-4db7-b969-5c67af6d086d
		summarizeBy: none
		sourceColumn: Texto

	partition TradTextos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoPasta & "dashboard\traducao\textos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Renomeado = Table.RenameColumns(Cabecalho, {{"pt", "PT-BR"}, {"en", "EN"}}),
				    Ultimo = Table.UnpivotOtherColumns(Renomeado, {"chave"}, "Idioma", "Texto"),
				    Tipado = Table.TransformColumnTypes(Ultimo, {{"chave", type text}, {"Idioma", type text}, {"Texto", type text}})
				in
				    Tipado

	annotation PBI_ResultType = Table

